# Django Settings
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Local development uses SQLite when DEBUG=True and DATABASE_URL is unset.
# Production on Render requires DATABASE_URL to point to PostgreSQL.
# For local PostgreSQL testing, set DATABASE_URL in your untracked .env file.
# Never commit a real database URL or credentials.

# Frontend URL (for CORS configuration in production)
FRONTEND_URL=https://your-frontend-url.vercel.app

# AI Provider Configuration
# Server default for users without a saved provider preference.
DEFAULT_LLM_PROVIDER=openai
ENABLE_LLM_FALLBACK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini remains available for manual selection.
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Legacy provider setting for code paths that still use the old router.
AI_PROVIDER_PRIORITY=openai

# Execution Configuration
EXECUTION_ENABLED=False
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MEMORY_LIMIT_MB=128
EXECUTION_MAX_OUTPUT_BYTES=65536
REPAIR_MAX_ATTEMPTS=3

# Email Configuration (for password reset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@bugsense.local

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
