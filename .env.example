# Django Settings
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development, PostgreSQL for production)
# For SQLite (default):
# No configuration needed - uses db.sqlite3

# For PostgreSQL:
# DB_NAME=bugsense
# DB_USER=bugsense
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-google-gemini-api-key-here
AI_PROVIDER_PRIORITY=gemini

AI_BASE_URL=
# Execution Configuration
EXECUTION_ENABLED=False
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MEMORY_LIMIT_MB=128
EXECUTION_MAX_OUTPUT_BYTES=65536
REPAIR_MAX_ATTEMPTS=3

# Email Configuration (for password reset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@bugsense.local

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
